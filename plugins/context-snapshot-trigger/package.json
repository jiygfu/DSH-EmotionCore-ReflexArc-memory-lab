{
  "name": "@local/context-snapshot-trigger",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "At 80% DSH context pressure, request one pre-compaction event snapshot from EmotionCore.",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "cordis.patch.yml", "README.md", "locale/*.json", "icon.svg"],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
